# ---------------------------------------------------------------------------
# Nexus Platform — переменные окружения
# Скопируйте в `.env.local` или задайте в Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase (Postgres + pgvector для RAG) ---
# Dashboard → Project Settings → API → Project URL / anon public
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI RAG Assistant (модуль №1, Google Gemini) ---
# Обязательный ключ Google AI Studio / Gemini API
GEMINI_API_KEY=

# Опционально: модели (по умолчанию gemini-2.5-flash + embedding-001)
# RAG_CHAT_MODEL=gemini-2.5-flash
# RAG_EMBEDDING_MODEL=embedding-001
# Альтернатива (если доступна на вашем аккаунте/API): text-embedding-004

# --- Будущие модули ---
# DATABASE_URL=
# REDIS_URL=
