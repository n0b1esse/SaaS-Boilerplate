# ---------------------------------------------------------------------------
# Nexus Platform — переменные окружения
# Скопируйте в `.env.local` или задайте в Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase (Postgres + pgvector для RAG) ---
# Dashboard → Project Settings → API → Project URL / anon public
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI RAG Assistant (модуль №1) ---
# Вариант A: прямой ключ OpenAI
OPENAI_API_KEY=

# Вариант B: Vercel AI Gateway
# AI_GATEWAY_API_KEY=

# Опционально: модели
# RAG_CHAT_MODEL=gpt-4.1-mini
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# --- Будущие модули ---
# DATABASE_URL=
# REDIS_URL=
