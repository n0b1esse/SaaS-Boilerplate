# --- AI RAG Assistant (модуль №1) ---
# Вариант A (проще для старта): прямой ключ OpenAI
OPENAI_API_KEY=

# Вариант B (рекомендуется на Vercel): AI Gateway
# AI_GATEWAY_API_KEY=

# Опционально: переопределение моделей
# RAG_CHAT_MODEL=gpt-4.1-mini
# RAG_EMBEDDING_MODEL=text-embedding-3-small

