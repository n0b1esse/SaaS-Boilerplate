# ---------------------------------------------------------------------------
# Nexus Platform — переменные окружения
# Скопируйте в `.env.local` или задайте в Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase (Postgres + pgvector для RAG) ---
# Dashboard → Project Settings → API → Project URL / anon public
#
# Сервер (API /api/rag) — читается на runtime, удобно для Vercel:
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
#
# Браузер (если понадобится client-side Supabase) — нужен rebuild после изменения:
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- AI RAG Assistant (модуль №1, Google Gemini) ---
# Обязательный ключ Google AI Studio / Gemini API
GEMINI_API_KEY=

# Опционально: модели (по умолчанию gemini-2.5-flash + gemini-embedding-001)
# RAG_CHAT_MODEL=gemini-2.5-flash
# RAG_EMBEDDING_MODEL=gemini-embedding-001

# --- Будущие модули ---
# DATABASE_URL=
# REDIS_URL=
